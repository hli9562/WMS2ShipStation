# Local configuration. No credentials are required for Simulation.
# Docker Compose explicitly passes only the variables listed in compose.yaml.
PORT=8080
# Enter your ShipStation V1 key and secret locally to load real carrier choices.
# Never commit credentials. Native startup loads this file automatically.
SHIPSTATION_API_KEY=
SHIPSTATION_API_SECRET=

# Legacy flag: the current development workflow forces test mode and disables paid labels.
WMS_ENABLE_LIVE_PURCHASE=false
