# Optional local configuration. No credentials are required for the scaffold/importer.
# Docker Compose explicitly passes only the variables listed in compose.yaml.
PORT=8080
# Leave real secrets out of source control. They are used only by the future provider adapter.
SHIPSTATION_API_KEY=
SHIPSTATION_API_SECRET=

# Enable only when ready for explicit paid label creation in the UI.
WMS_ENABLE_LIVE_PURCHASE=false
